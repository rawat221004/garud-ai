# GARUD AI backend environment configuration
# Copy this file to backend/.env and edit values as needed.
# NEVER commit backend/.env to version control.

# Optional: Google Gemini API key enables the live AI Incident Commander
# (situation briefings and incident triage via Gemini).
# Without a key, GARUD AI automatically uses the deterministic,
# clearly-labelled rule-based fallback engine.
GEMINI_API_KEY=
# Model access and usage limits depend on your Gemini account and plan.
GEMINI_MODEL=gemini-3.6-flash

# Optional overrides
# DB_PATH=data/garud.db
# HTTP_TIMEOUT=15
